# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Сервер слушает только этот компьютер. Другие значения HOST запрещены.
HOST=127.0.0.1
PORT=8787

# Случайная строка от 32 символов: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Адреса админки, которым разрешено обращаться к API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Первый администратор — создаётся при первом запуске, если в базе ещё нет пользователей.
# В базе пароль хранится только в виде хэша. С этими же логином и паролем входите в тестовую панель.
ADMIN_LOGIN=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Администратор

# Локально сервер работает только с тестовой базой server/data-test (вымышленные данные):
# npm run dev в корне создаёт её сам, пересоздать — npm run test-data. Базу с клиентами без
# метки «тест» (например, копию рабочей) локальный сервер не откроет. Рабочие данные — в облаке.
